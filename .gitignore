# =========================================================================
# Bob Ventas - .gitignore
# IMPORTANTE: key.properties y los archivos .jks/.keystore NUNCA se suben
# a GitHub (contienen las contrasenas de firma de la app).
# =========================================================================

# --- SECRETOS (firma de la app) ---
key.properties
**/key.properties
*.jks
*.keystore
android/app/bob-ventas-key.jks

# --- Flutter / Dart ---
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Ephemeral de plataformas desktop (se regenera solo)
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/

# Simbolizacion y ofuscacion
app.*.symbols
app.*.map.json

# --- IDEs ---
*.iml
*.ipr
*.iws
.idea/
.vscode/

# --- Android (artefactos locales) ---
/android/app/debug
/android/app/profile
/android/app/release
local.properties
.gradle/
captures/

# Base de datos local (no versionar datos reales del negocio)
*.db
